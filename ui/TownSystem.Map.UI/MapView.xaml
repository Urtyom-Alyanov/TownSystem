<UserControl x:Class="TownSystem.Map.UI.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TownSystem.Map.UI.Views"
             Background="#0C1115" FontFamily="Segoe UI" DataContextChanged="ChangeMap">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelColor" Color="#202C34"/>
        <SolidColorBrush x:Key="LineColor" Color="#344550"/>
        <SolidColorBrush x:Key="TextColor" Color="#F0F5F6"/>
        <SolidColorBrush x:Key="MutedColor" Color="#ABC0C7"/>
        <SolidColorBrush x:Key="AccentColor" Color="#70DABC"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Background" Value="#263640"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}" CornerRadius="8"
                                Background="{TemplateBinding Background}" BorderBrush="{StaticResource LineColor}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#354E53"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ZoomButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Width" Value="31"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="LayerItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource MutedColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tab" Padding="11,6" Margin="2" CornerRadius="7" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#293D44"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#294A44"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Legend" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedColor}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="InfoValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="12,8">
            <Border Style="{StaticResource Panel}" Padding="12,6" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Карта города" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Foreground="{StaticResource MutedColor}" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Run Text="{Binding Width, Mode=OneWay}"/><Run Text=" × "/><Run Text="{Binding Height, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Style="{StaticResource Panel}" Padding="3" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="−" Click="ZoomOut" Style="{StaticResource ZoomButton}"
                                AutomationProperties.Name="Уменьшить масштаб" ToolTip="Уменьшить масштаб"/>
                        <TextBlock x:Name="ZoomText" Text="100 %" MinWidth="54" TextAlignment="Center" ToolTip="Масштаб относительно вида «По экрану»"
                                   Foreground="{StaticResource MutedColor}" VerticalAlignment="Center"/>
                        <Button Content="+" Click="ZoomIn" Style="{StaticResource ZoomButton}"
                                AutomationProperties.Name="Увеличить масштаб" ToolTip="Увеличить масштаб"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Вся карта" Click="FitMap" Style="{StaticResource ActionButton}" Margin="0,0,3,0"/>
                        <Button Content="По экрану" Click="FillMap" Style="{StaticResource ActionButton}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>


        <!-- Тут все слои едут и приближаются вместе с картой -->
        <Canvas x:Name="MapViewport" Grid.Row="1" Background="#DCE6E8" ClipToBounds="True" SizeChanged="ResizeMap"
                PreviewMouseWheel="ZoomMap" PreviewMouseDown="PressMap" PreviewMouseUp="ReleaseMap" MouseMove="MovePointer"
                MouseLeave="LeaveMap" LostMouseCapture="LoseCapture" Cursor="Cross" AutomationProperties.Name="Карта города">
            <Grid x:Name="MapSurface" Width="0" Height="0" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="MapScale"/>
                        <TranslateTransform x:Name="MapOffset"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <Image x:Name="TerrainImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <Image x:Name="ContourImage" Stretch="Fill"/>
                <Image x:Name="ResourceImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <Image x:Name="ResourceLabelImage" Stretch="Fill"/>
                <Canvas x:Name="MapObjects"/>
                <Canvas>
                    <Rectangle x:Name="HoverOutline" Width="{x:Static local:MapView.CellSize}" Height="{x:Static local:MapView.CellSize}"
                               Stroke="#405C71" StrokeThickness="3" Visibility="Collapsed"/>
                    <Rectangle x:Name="SelectionOutline" Width="{x:Static local:MapView.CellSize}" Height="{x:Static local:MapView.CellSize}"
                               Stroke="#106266" StrokeThickness="4" Visibility="Collapsed"/>
                </Canvas>
            </Grid>
        </Canvas>

        <Grid Grid.Row="2" Margin="12,9" MaxWidth="1150">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="9"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}"
                             ItemContainerStyle="{StaticResource LayerItem}" Background="#151F26" BorderThickness="0"
                             HorizontalAlignment="Left" AutomationProperties.Name="Слои карты">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <Border Background="{TemplateBinding Background}" CornerRadius="9">
                                    <ItemsPresenter/>
                                </Border>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <Grid Margin="3,7,0,7" MinHeight="32">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Legend}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedLayer}" Value="Местность">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="●" Foreground="#F3EEDF"/><Run Text=" Равнины    "/>
                            <Run Text="●" Foreground="#B5D6AC"/><Run Text=" Леса    "/>
                            <Run Text="●" Foreground="#A8AFB6"/><Run Text=" Горы    "/>
                            <Run Text="●" Foreground="#81C2EB"/><Run Text=" Вода"/>
                        </TextBlock>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Legend}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedLayer}" Value="Ресурсы">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="Fe" Foreground="Salmon"/><Run Text=" железо · "/>
                            <Run Text="Cu" Foreground="Tan"/><Run Text=" медь · "/>
                            <Run Text="Н" Foreground="Plum"/><Run Text=" нефть · "/>
                            <Run Text="Г" Foreground="MediumTurquoise"/><Run Text=" газ · "/>
                            <Run Text="У" Foreground="LightSlateGray"/><Run Text=" уголь · "/>
                            <Run Text="●" Foreground="#B5D6AC"/><Run Text=" древесина"/>
                        </TextBlock>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Legend}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedLayer}" Value="Рельеф">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="Глубина "/><Run Text="●" Foreground="#5EADCF"/><Run Text=" −50 м и глубже   "/>
                            <Run Text="●" Foreground="#A3D8E9"/><Run Text=" выше −50 м"/>
                            <LineBreak/>
                            <Run Text="Высота "/><Run Text="●" Foreground="#ADCF91"/><Run Text=" 0–99   "/>
                            <Run Text="●" Foreground="#D2DD94"/><Run Text=" 100–199   "/>
                            <Run Text="●" Foreground="#F3E19C"/><Run Text=" 200–299   "/>
                            <Run Text="●" Foreground="#EAB977"/><Run Text=" 300–399   "/>
                            <Run Text="●" Foreground="#D3885C"/><Run Text=" 400+ м"/>
                        </TextBlock>
                    </Grid>

                    <WrapPanel VerticalAlignment="Center">
                        <Button Content="Новая карта" Command="{Binding GenerateMapCommand}" Margin="0,0,10,0"
                                ToolTip="Сгенерировать новую местность и месторождения">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                    <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanGenerateMap}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="Колесо меняет масштаб · Карту можно тянуть" Foreground="{StaticResource MutedColor}"
                                   FontSize="11" VerticalAlignment="Center" Margin="3,5,0,5"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,7">
                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource AccentColor}" FontWeight="SemiBold"
                                   Text="{Binding SelectedCell.CoordinatesText, FallbackValue=Выберите клетку}"/>
                        <TextBlock Text="Участок" FontWeight="SemiBold" FontSize="15"/>
                    </DockPanel>
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,9,5">
                            <TextBlock Text="Местность" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding SelectedCell.TerrainName, FallbackValue=—}" Style="{StaticResource InfoValue}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,9,5">
                            <TextBlock Text="{Binding SelectedCell.ReliefLabel, FallbackValue=Высота}" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding SelectedCell.ReliefValue, StringFormat={}{0} м, FallbackValue=—}" Style="{StaticResource InfoValue}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,5">
                            <TextBlock Text="Размещение" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding SelectedCell.BuildStatus, FallbackValue=—}" ToolTip="{Binding SelectedCell.BuildStatus}" Style="{StaticResource InfoValue}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,9,0">
                            <TextBlock Text="Ресурс" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding SelectedCell.ResourceName, FallbackValue=—}" Style="{StaticResource InfoValue}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Запасы" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding SelectedCell.ResourceAmount, FallbackValue=—}" Style="{StaticResource InfoValue}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
