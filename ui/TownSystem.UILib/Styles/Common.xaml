<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Общие стили, чтобы вкладки всех модулей выглядели одинаково.
         Подключение: <ResourceDictionary Source="pack://application:,,,/TownSystem.UILib;component/Styles/Common.xaml"/> -->

    <SolidColorBrush x:Key="Brush.Accent" Color="#2D6CDF"/>
    <SolidColorBrush x:Key="Brush.CardBackground" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#D9DCE1"/>

    <Style x:Key="Text.Header" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
</ResourceDictionary>
