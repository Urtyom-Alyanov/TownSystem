<Window x:Class="TownSystem.UIApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TownSystem" Height="800" Width="1200" WindowState="Maximized">
    <TabControl ItemsSource="{Binding Tabs}">
        <TabControl.ItemTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Title}" Margin="10,5" FontSize="14"/>
            </DataTemplate>
        </TabControl.ItemTemplate>
    </TabControl>
</Window>