<UserControl x:Class="TownSystem.Population.UI.Views.PopulationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0C1115" FontFamily="Segoe UI">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelColor" Color="#202C34"/>
        <SolidColorBrush x:Key="SubPanelColor" Color="#151F26"/>
        <SolidColorBrush x:Key="LineColor" Color="#344550"/>
        <SolidColorBrush x:Key="TextColor" Color="#F0F5F6"/>
        <SolidColorBrush x:Key="MutedColor" Color="#ABC0C7"/>
        <SolidColorBrush x:Key="AccentColor" Color="#70DABC"/>
        <SolidColorBrush x:Key="DangerColor" Color="#E36D6D"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Background" Value="#263640"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}" CornerRadius="8"
                                Background="{TemplateBinding Background}" BorderBrush="{StaticResource LineColor}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#354E53"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTabItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource MutedColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tab" Padding="11,6" Margin="2" CornerRadius="7" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#293D44"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#294A44"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemCard" Background="{StaticResource SubPanelColor}" BorderBrush="{StaticResource LineColor}"
                                BorderThickness="1" CornerRadius="9" Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemCard" Property="Background" Value="#293D44"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemCard" Property="Background" Value="#294A44"/>
                                <Setter TargetName="ItemCard" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SubPanelColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Background" Value="{StaticResource SubPanelColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource SubPanelColor}" BorderBrush="{StaticResource LineColor}"
                                                BorderThickness="1" CornerRadius="7" Padding="8,5">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="▾" Foreground="{StaticResource MutedColor}" Margin="6,0,0,0"/>
                                                <ContentPresenter/>
                                            </DockPanel>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="{StaticResource PanelColor}" BorderBrush="{StaticResource LineColor}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,3,0,0" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="2">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#293D44"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#294A44"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedColor}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="InfoValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя плашка сводки -->
        <Grid Margin="0,0,0,10">
            <Border Style="{StaticResource Panel}" Padding="12,7" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Население города" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Foreground="{StaticResource MutedColor}" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Run Text="Жителей: "/><Run Text="{Binding CitizenCount, Mode=OneWay}" Foreground="{StaticResource AccentColor}" FontWeight="SemiBold"/>
                        <Run Text="  ·  Семей: "/><Run Text="{Binding FamilyCount, Mode=OneWay}" Foreground="{StaticResource TextColor}" FontWeight="SemiBold"/>
                        <Run Text="  ·  Домохозяйств: "/><Run Text="{Binding HouseholdCount, Mode=OneWay}" Foreground="{StaticResource TextColor}" FontWeight="SemiBold"/>
                        <Run Text="  ·  Без жилья: "/><Run Text="{Binding HomelessCount, Mode=OneWay}" Foreground="{StaticResource TextColor}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: переключатель разделов, список и форма создания -->
            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                             ItemContainerStyle="{StaticResource SectionTabItem}" Background="#151F26"
                             BorderThickness="0" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <Border Background="{TemplateBinding Background}" CornerRadius="9">
                                    <ItemsPresenter/>
                                </Border>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <!-- Раздел: Горожане -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Горожане">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox ItemsSource="{Binding Citizens.Items}" SelectedItem="{Binding Citizens.SelectedItem}"
                                 ItemContainerStyle="{StaticResource CardListItem}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource AccentColor}" FontSize="12"
                                                   Text="{Binding Age, StringFormat={}{0} лет}" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Foreground="{StaticResource MutedColor}" FontSize="11">
                                                <Run Text="Здоровье: "/><Run Text="{Binding Health, StringFormat={}{0:P0}, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Новый житель" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Имя" Style="{StaticResource InfoLabel}"/>
                                    <TextBox Text="{Binding NewCitizenName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Возраст" Style="{StaticResource InfoLabel}"/>
                                    <TextBox Text="{Binding NewCitizenAge, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Образование" Style="{StaticResource InfoLabel}"/>
                            <ComboBox ItemsSource="{Binding EducationOptions}" SelectedItem="{Binding SelectedEducationOption}"
                                      Style="{StaticResource DarkComboBox}" Margin="0,0,0,8">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="Зарегистрировать жителя" Command="{Binding AddCitizenCommand}"
                                    Style="{StaticResource ActionButton}" Foreground="{StaticResource AccentColor}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Раздел: Семьи -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Семьи">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily}"
                                 ItemContainerStyle="{StaticResource CardListItem}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource AccentColor}" FontSize="12"
                                                   Text="{Binding MemberCount, StringFormat={}{0} чел.}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Новая семья" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                            <TextBlock Text="Фамилия / название семьи" Style="{StaticResource InfoLabel}"/>
                            <TextBox Text="{Binding NewFamilyName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,0,0,8"/>
                            <Button Content="Создать семью" Command="{Binding AddFamilyCommand}"
                                    Style="{StaticResource ActionButton}" Foreground="{StaticResource AccentColor}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Раздел: Домохозяйства -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Домохозяйства">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox ItemsSource="{Binding Households}" SelectedItem="{Binding SelectedHousehold}"
                                 ItemContainerStyle="{StaticResource CardListItem}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource AccentColor}" FontSize="12"
                                                   Text="{Binding Satisfaction, StringFormat={}{0:P0}}" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Family.Name}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding Family.MemberCount, StringFormat=Участников: {0}}"
                                                       Foreground="{StaticResource MutedColor}" FontSize="11"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Заселение семьи" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                            <TextBlock Text="Семья" Style="{StaticResource InfoLabel}"/>
                            <ComboBox ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedSettleFamily}"
                                      Style="{StaticResource DarkComboBox}" Margin="0,0,0,6">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Жилой дом" Style="{StaticResource InfoLabel}"/>
                            <ComboBox ItemsSource="{Binding ResidentialBuildings}" SelectedItem="{Binding SelectedSettleBuilding}"
                                      Style="{StaticResource DarkComboBox}" Margin="0,0,0,8">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="Заселить в дом" Command="{Binding SettleHouseholdCommand}"
                                    Style="{StaticResource ActionButton}" Foreground="{StaticResource AccentColor}"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Правая колонка: карточка выбранного объекта -->
            <Grid Grid.Column="2">
                <!-- Карточка горожанина -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Горожане">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource AccentColor}" FontWeight="SemiBold"
                                       Text="{Binding SelectedCitizenIdText}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedCitizenName}" FontWeight="SemiBold" FontSize="16"/>
                        </DockPanel>

                        <UniformGrid Columns="3" Margin="0,0,0,14">
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="Возраст" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding SelectedCitizenAgeText}" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="Здоровье" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding SelectedCitizenHealthText}" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Образование" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding SelectedCitizenEducationText}" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Семья" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding SelectedCitizenFamilyText}" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Место жительства" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding SelectedCitizenHomeText}" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Позиция" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding SelectedCitizenPositionText}" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="Управление семьёй жителя" Style="{StaticResource InfoLabel}"/>
                        <ComboBox ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedTargetFamilyForCitizen}"
                                  Style="{StaticResource DarkComboBox}" Margin="0,0,0,10" MaxWidth="320" HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <WrapPanel>
                            <Button Content="Добавить в семью" Command="{Binding AddCitizenToFamilyCommand}"
                                    Style="{StaticResource ActionButton}" Foreground="{StaticResource AccentColor}" Margin="0,0,8,0"/>
                            <Button Content="Убрать из семьи" Command="{Binding RemoveCitizenFromFamilyCommand}"
                                    Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
                            <Button Content="Удалить жителя" Command="{Binding RemoveCitizenCommand}"
                                    Style="{StaticResource ActionButton}" Foreground="{StaticResource DangerColor}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Карточка семьи -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Семьи">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource AccentColor}" FontWeight="SemiBold"
                                           Text="{Binding SelectedFamilyMembersCountText}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedFamilyName}" FontWeight="SemiBold" FontSize="16"/>
                            </DockPanel>

                            <UniformGrid Columns="3" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Жилой дом" Style="{StaticResource InfoLabel}"/>
                                    <TextBlock Text="{Binding SelectedFamilyHomeText}" Style="{StaticResource InfoValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Мин. комнат" Style="{StaticResource InfoLabel}"/>
                                    <TextBlock Text="{Binding SelectedFamilyMinRoomsText}" Style="{StaticResource InfoValue}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Удовлетворённость" Style="{StaticResource InfoLabel}"/>
                                    <TextBlock Text="{Binding SelectedFamilySatisfactionText}" Style="{StaticResource InfoValue}"/>
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="Жилой дом для заселения / переселения" Style="{StaticResource InfoLabel}"/>
                            <ComboBox ItemsSource="{Binding ResidentialBuildings}" SelectedItem="{Binding SelectedTargetBuildingForFamily}"
                                      Style="{StaticResource DarkComboBox}" Margin="0,0,0,10" MaxWidth="360" HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <WrapPanel Margin="0,0,0,14">
                                <Button Content="{Binding SettleOrMoveFamilyButtonText}" Command="{Binding SettleOrMoveFamilyCommand}"
                                        Style="{StaticResource ActionButton}" Foreground="{StaticResource AccentColor}" Margin="0,0,8,0"/>
                                <Button Content="Выселить" Command="{Binding EvictFamilyCommand}"
                                        Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
                                <Button Content="Расформировать семью" Command="{Binding RemoveFamilyCommand}"
                                        Style="{StaticResource ActionButton}" Foreground="{StaticResource DangerColor}"/>
                            </WrapPanel>

                            <TextBlock Text="Состав семьи" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                        </StackPanel>

                        <ListBox ItemsSource="{Binding SelectedFamilyMembers}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{StaticResource SubPanelColor}" BorderBrush="{StaticResource LineColor}"
                                                        BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedColor}"
                                                   Text="{Binding Age, StringFormat={}{0} лет}"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Карточка домохозяйства -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Домохозяйства">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource AccentColor}" FontWeight="SemiBold"
                                           Text="{Binding SelectedHouseholdBuildingName}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedHouseholdFamilyName}" FontWeight="SemiBold" FontSize="16"/>
                            </DockPanel>

                            <UniformGrid Columns="3" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Дата заселения" Style="{StaticResource InfoLabel}"/>
                                    <TextBlock Text="{Binding SelectedHouseholdMoveInDateText}" Style="{StaticResource InfoValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Удовлетворённость" Style="{StaticResource InfoLabel}"/>
                                    <TextBlock Text="{Binding SelectedHouseholdSatisfactionText}" Style="{StaticResource InfoValue}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Заполненность дома" Style="{StaticResource InfoLabel}"/>
                                    <TextBlock Text="{Binding SelectedHouseholdOccupancyText}" Style="{StaticResource InfoValue}"/>
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="Новый дом для переселения" Style="{StaticResource InfoLabel}"/>
                            <ComboBox ItemsSource="{Binding ResidentialBuildings}" SelectedItem="{Binding SelectedTargetBuildingForHousehold}"
                                      Style="{StaticResource DarkComboBox}" Margin="0,0,0,10" MaxWidth="360" HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <WrapPanel Margin="0,0,0,14">
                                <Button Content="Переселить" Command="{Binding MoveHouseholdCommand}"
                                        Style="{StaticResource ActionButton}" Foreground="{StaticResource AccentColor}" Margin="0,0,8,0"/>
                                <Button Content="Выселить" Command="{Binding EvictHouseholdCommand}"
                                        Style="{StaticResource ActionButton}" Foreground="{StaticResource DangerColor}"/>
                            </WrapPanel>

                            <TextBlock Text="Проживающие члены семьи" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                        </StackPanel>

                        <ListBox ItemsSource="{Binding SelectedHouseholdMembers}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{StaticResource SubPanelColor}" BorderBrush="{StaticResource LineColor}"
                                                        BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedColor}"
                                                   Text="{Binding Age, StringFormat={}{0} лет}"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Строка статуса -->
        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="12,7" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>