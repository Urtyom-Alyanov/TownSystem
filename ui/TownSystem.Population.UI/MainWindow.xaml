<Window x:Class="TownSystem.Population.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TownSystem.Population.UI.Views"
        Title="TownSystem — Население" Width="1180" Height="820" MinWidth="820" MinHeight="600"
        Background="#0C1115" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#202C34" BorderBrush="#344550" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="ClockText" Foreground="#ABC0C7" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="ToggleSimButton" Content="Старт симуляции" Click="ToggleSimulation"
                            Background="#263640" Foreground="#70DABC" BorderBrush="#344550" Padding="12,5" Cursor="Hand"/>
                </StackPanel>
                <TextBlock Text="Автономный просмотр: Население" Foreground="#F0F5F6" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <views:PopulationView x:Name="ModuleView" Grid.Row="1"/>
    </Grid>
</Window>